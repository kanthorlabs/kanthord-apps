{
  "name": "kanthord",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.24.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "clean": "rm -rf dist node_modules",
    "dev": "vite",
    "dev:all": "node mock/daemon.mjs & vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "mock": "node mock/daemon.mjs",
    "prepare": "husky",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run format:check && pnpm run verify:guards",
    "verify:guards": "bash scripts/lane-check.test.sh && bash scripts/turn-snapshot.test.sh && bash scripts/persona-sync.test.sh",
    "verify:handoff": "node scripts/verify-handoff.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "elkjs": "0.12.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.47.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.9.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^26",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.24.0"
}
